<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <title>Оплата детского сада</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #f4f4f4;
        }
        .container {
            width: 400px;
            margin: 20px auto;
            background: white;
            padding: 20px;
            border-radius: 8px;
            box-shadow: 0 0 10px rgba(0,0,0,0.1);
        }
        h2 {
            text-align: center;
            font-size: 20px;
        }
        .form-group {
            margin-bottom: 15px;
        }
        label {
            display: block;
            margin-bottom: 5px;
            font-weight: bold;
            font-size: 14px;
        }
        input, select {
            width: 100%;
            padding: 8px;
            box-sizing: border-box;
            border: 1px solid #ccc;
            border-radius: 4px;
        }
        input:disabled {
            background-color: #e9e9e9;
            color: #666;
        }
        .buttons {
            display: flex;
            justify-content: space-between;
            margin-top: 20px;
        }
        button {
            width: 48%;
            padding: 10px;
            background-color: #4CAF50;
            color: white;
            border: none;
            border-radius: 4px;
            cursor: pointer;
        }
        button:hover {
            background-color: #45a049;
        }
        .clear-btn {
            background-color: #f44336;
        }
        .clear-btn:hover {
            background-color: #da190b;
        }
        #resultBlock {
            margin-top: 20px;
            padding-top: 15px;
            border-top: 2px solid #eee;
            display: none;
        }
    </style>
</head>
<body>

<div class="container">
    <h2>Расчет стоимости детского сада</h2>

    <div class="form-group">
        <label>ФИО ребенка:</label>
        <input type="text" id="fio">
    </div>

    <div class="form-group">
        <label>Выберите месяц:</label>
        <select id="month" onchange="changePrice()">
            <option value="winter">Зима (Декабрь, Январь, Февраль)</option>
            <option value="spring">Весна (Март, Апрель, Май)</option>
            <option value="summer">Лето (Июнь, Июль, Август)</option>
            <option value="autumn">Осень (Сентябрь, Октябрь, Ноябрь)</option>
        </select>
    </div>

    <div class="form-group">
        <label>Посещено дней:</label>
        <input type="number" id="days" min="1" max="31">
    </div>

    <div class="form-group">
        <label>Дополнительная услуга:</label>
        <select id="service">
            <option value="0">Нет</option>
            <option value="2000">Веселый мяч (2000 руб.)</option>
            <option value="3000">Каляка-маляка (3000 руб.)</option>
            <option value="2500">Вокал (2500 руб.)</option>
        </select>
    </div>

    <div class="form-group">
        <label>Стоимость 1 дня:</label>
        <input type="text" id="price" disabled>
    </div>

    <div class="buttons">
        <button onclick="calculate()">Рассчитать</button>
        <button class="clear-btn" onclick="clearForm()">Очистить</button>
    </div>

    <div id="resultBlock">
        <div class="form-group">
            <label>Сумма к оплате:</label>
            <input type="text" id="total" disabled>
        </div>
    </div>
</div>

<script>
    function changePrice() {
        var month = document.getElementById("month").value;
        var priceField = document.getElementById("price");
        
        if (month == "winter") {
            priceField.value = 600;
        } else if (month == "spring") {
            priceField.value = 400;
        } else if (month == "summer") {
            priceField.value = 300;
        } else if (month == "autumn") {
            priceField.value = 400;
        }
    }

    function calculate() {
        var fio = document.getElementById("fio").value;
        var daysText = document.getElementById("days").value;
        
        if (fio == "") {
            alert("Пожалуйста, введите ФИО ребенка!");
            return;
        }

        if (daysText == "") {
            alert("Пожалуйста, введите количество дней!");
            return;
        }
        
        var days = Number(daysText);

        if (days <= 0 || days % 1 != 0) {
            alert("Дни должны быть целым положительным числом!");
            return;
        }

        if (days > 31) {
            alert("В месяце не может быть больше 31 дня!");
            return;
        }

        var price = Number(document.getElementById("price").value);
        var service = Number(document.getElementById("service").value);
        
        var totalSum = (price * days) + service;

        document.getElementById("total").value = totalSum + " руб.";
        document.getElementById("resultBlock").style.display = "block";
    }

    function clearForm() {
        document.getElementById("fio").value = "";
        document.getElementById("days").value = "";
        document.getElementById("service").value = "0";
        document.getElementById("month").value = "winter";
        changePrice(); 
        
        document.getElementById("resultBlock").style.display = "none";
        document.getElementById("total").value = "";
    }

    changePrice();
</script>

</body>
</html>
